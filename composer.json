{
    "name": "contenir/contenir-asset-laminas-mvc",
    "description": "Laminas MVC adapter for Contenir assets — keyed, profile-driven responsive image variants (incl. WebP/AVIF) backed by contenir/storage.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/storage": "^0.6.1 || ^2.0",
        "laminas/laminas-cli": "^1.8",
        "laminas/laminas-http": "^2.0",
        "laminas/laminas-mvc": "^3.0",
        "laminas/laminas-router": "^3.0",
        "laminas/laminas-view": "^2.0",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Asset\\Laminas\\Mvc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Asset\\Laminas\\Mvc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "config": {
        "allow-plugins": {
            "laminas/laminas-component-installer": true
        },
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laminas": {
            "module": "Contenir\\Asset\\Laminas\\Mvc"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
